# Copy this file to .env and adjust the values.
# Never commit .env or the session/ directory.

# Owner phone number in international format, digits only.
# Set this to the human owner's number for owner-only commands.
OWNER_NUMBER=
# Additional owner JIDs, comma separated (e.g. 628123@s.whatsapp.net,123456@lid).
OWNER_JIDS=

BOT_NAME=OngBak-Bot
OWNER_NAME=Ong-Bak
OWNER_GITHUB=rickyzakariap

# Prefix for text commands.
COMMAND_PREFIX=.

# Directory used by Baileys for the WhatsApp login session.
SESSION_NAME=session

# IANA timezone used by scheduled messages and birthday reminders.
TIMEZONE=Asia/Jakarta

# Optional: path to yt-dlp for the .yt video command.
# Install it first (e.g. pip install yt-dlp) or leave empty to disable .yt.
YTDLP_PATH=yt-dlp
